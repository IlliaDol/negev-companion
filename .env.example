# Copy this file to .env or set the variables in the service environment.
# Never commit real credentials.

TELEGRAM_BOT_TOKEN=
# Optional: pin the owner before first /start. If blank, the first private /start claims the bot.
TELEGRAM_OWNER_ID=
DEEPSEEK_API_KEY=
# Optional additional keys for the same DeepSeek-compatible API. Use commas,
# semicolons, or separate numbered variables (DEEPSEEK_API_KEY_1, _2, ...).
DEEPSEEK_API_KEYS=
# DEEPSEEK_API_KEY_1=
# DEEPSEEK_API_KEY_2=

# Use the model name available to your DeepSeek account. The bot can try fallbacks.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_FALLBACKS=deepseek-flash,deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional OpenRouter and OpenAI-compatible provider settings. The control
# center can add custom providers and save their non-secret settings in data/providers.json.
# Leave these blank to use the control center's saved selection (DeepSeek by default).
NEGEV_PROVIDER=
NEGEV_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Private Telegram companion
OPENROUTER_INPUT_USD_PER_M=
OPENROUTER_CACHE_USD_PER_M=
OPENROUTER_OUTPUT_USD_PER_M=
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=
OPENAI_INPUT_USD_PER_M=
OPENAI_CACHE_USD_PER_M=
OPENAI_OUTPUT_USD_PER_M=

# Claude uses Anthropic's native Messages API. Both the standard Anthropic
# names and the CLAUDE_* aliases are accepted; do not fill both unless they
# are intentionally different key pools.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
CLAUDE_API_KEY=
CLAUDE_API_KEYS=
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODELS=claude-sonnet-4-6,claude-opus-4-6,claude-haiku-4-5-20251001
CLAUDE_INPUT_USD_PER_M=
CLAUDE_CACHE_USD_PER_M=
CLAUDE_CACHE_WRITE_USD_PER_M=
CLAUDE_OUTPUT_USD_PER_M=

# GLM is served through Z.AI's OpenAI-compatible chat-completions API. Both
# GLM_* and the conventional ZAI_* key names are accepted.
GLM_API_KEY=
GLM_API_KEYS=
ZAI_API_KEY=
ZAI_API_KEYS=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODELS=glm-5.1,glm-5,glm-4.7
GLM_INPUT_USD_PER_M=
GLM_CACHE_USD_PER_M=
GLM_CACHE_WRITE_USD_PER_M=
GLM_OUTPUT_USD_PER_M=

# Gemini uses Google's native generateContent API and x-goog-api-key auth.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-3.8-flash
GEMINI_INPUT_USD_PER_M=
GEMINI_CACHE_USD_PER_M=
GEMINI_CACHE_WRITE_USD_PER_M=
GEMINI_OUTPUT_USD_PER_M=

# Blank means the Windows machine's actual local timezone. Set an IANA zone only if desired.
NEGEV_TIMEZONE=
NEGEV_LOCATION=Your city, country
NEGEV_DISPLAY_NAME=Private companion
NEGEV_PERSONA_FILE=./persona.local.json
NEGEV_DATA_DIR=./data
NEGEV_LOG_DIR=./logs
# Auto-detected in %LOCALAPPDATA%\Programs\whisper-pipeline\(LIVE\ or root); override only if needed.
NEGEV_MEDIA_PIPELINE=
# Optional local document-to-Markdown converter. Leave blank to support only
# built-in text fallback; on Windows this can point to a Files to Markdown.exe.
NEGEV_DOCUMENT_PIPELINE=
NEGEV_MAX_MEDIA_MB=20
NEGEV_MAX_DOCUMENT_CHARS=120000
NEGEV_DAILY_PROACTIVE_MIN=6
NEGEV_DAILY_PROACTIVE_MAX=9

# Published-rate defaults are configurable because provider pricing can change.
DEEPSEEK_INPUT_USD_PER_M=0.15
DEEPSEEK_CACHE_USD_PER_M=0.003
DEEPSEEK_OUTPUT_USD_PER_M=0.60
